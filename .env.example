# Environment variables for optional third-party APIs (configured via AI Studio Secrets panel).
# Firebase AI Logic uses App Check attestation instead of GEMINI_API_KEY (do NOT add GEMINI_API_KEY here).
# COINGECKO_DEMO_API_KEY: Optional free CoinGecko Demo API key (leave default for unauthenticated public access).
COINGECKO_DEMO_API_KEY=OPTIONAL_COINGECKO_DEMO_KEY
# DEEPSEEK_API_KEY: Optional DeepSeek API key for DeepSeek provider interface (disabled automatically if unset).
DEEPSEEK_API_KEY=OPTIONAL_DEEPSEEK_KEY
